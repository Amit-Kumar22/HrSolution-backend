########################################################################
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# docker compose reads .env automatically. To run the app from Maven or the IDE
# instead, export these into your shell:
#
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# Every variable here has a safe local default in application-local.properties
# EXCEPT DB_PASSWORD. The dev and prod profiles have no defaults at all - a
# missing variable there stops the application at startup, deliberately.
########################################################################

# ---------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------
# local | dev | prod
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Default (local profile): your own MySQL on 3306.
DB_URL=jdbc:mysql://localhost:3306/hrsolution_local_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=HrPass@123

# To use the docker-compose MySQL instead, which is published on 3307:
# DB_URL=jdbc:mysql://localhost:3307/hrsolution_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
# DB_USERNAME=hrsolution
# DB_PASSWORD=hrsolutionpassword

DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# Credentials for the MySQL container itself, read by docker-compose.yml.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=hrsolution_db
MYSQL_USER=hrsolution
MYSQL_PASSWORD=hrsolutionpassword

# ---------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------
# Defaults target MailHog from docker-compose: no auth, no TLS, UI on :8025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@hrsolution.local
MAIL_ADMIN_RECIPIENT=admin@hrsolution.local

# For a real SMTP provider, switch to:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=your-app-specific-password   <-- an app password, not the real one

# ---------------------------------------------------------------------
# CORS - comma-separated browser origins allowed to call the API.
# Empty means none. Wildcards are not supported, because credentials are allowed.
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=25MB

# ---------------------------------------------------------------------
# Caching: caffeine | none  (redis becomes available if the starter is added)
# ---------------------------------------------------------------------
CACHE_TYPE=caffeine

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL_APP=DEBUG

# ---------------------------------------------------------------------
# API documentation. Keep false in production: Swagger UI enumerates every
# endpoint and request shape.
# ---------------------------------------------------------------------
SPRINGDOC_ENABLED=true
OPENAPI_CONTACT_NAME=
OPENAPI_CONTACT_EMAIL=

########################################################################
# Variables consumed by LATER phases. Listed now so the full set is in one
# place; nothing reads them yet, so leaving them unset is fine for Phase 1.
########################################################################

# --- Phase 2: authentication ---
# RS256 key pair for signing access tokens. Generate with:
#   mkdir -p keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem
#   openssl rsa -pubout -in keys/jwt-private.pem -out keys/jwt-public.pem
# The keys/ directory is gitignored. In production, inject the PEM contents
# through the secret store rather than mounting files.
# JWT_PRIVATE_KEY_LOCATION=file:./keys/jwt-private.pem
# JWT_PUBLIC_KEY_LOCATION=file:./keys/jwt-public.pem
# JWT_ISSUER=https://api.hrsolution.local
# JWT_ACCESS_TOKEN_MINUTES=15
# JWT_REFRESH_TOKEN_DAYS=7
# JWT_REFRESH_TOKEN_REMEMBER_ME_DAYS=30

# The seeded SUPER_ADMIN. The password is read at migration time and never
# written to a migration file. Change it immediately after first login.
# SUPER_ADMIN_EMAIL=admin@hrsolution.local
# SUPER_ADMIN_PASSWORD=

# --- Phase 6: encryption of Aadhaar, PAN and bank account numbers ---
# AES-256 key, base64-encoded, for the JPA AttributeConverter. Generate with:
#   openssl rand -base64 32
# Losing this key makes every encrypted column permanently unreadable - back it
# up somewhere separate from the database backups.
# FIELD_ENCRYPTION_KEY=

# --- Phase 3 onwards: document storage ---
# STORAGE_TYPE=local
# STORAGE_LOCAL_PATH=./uploads
