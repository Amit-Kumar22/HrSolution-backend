# Stop Lombok config lookup walking above the project root.
config.stopBubbling = true

# Lombok does not, by default, copy field annotations onto the parameters of the
# constructor that @RequiredArgsConstructor generates. For Spring that silently
# breaks injection: a @Qualifier("handlerExceptionResolver") field loses its
# qualifier, and since a web context holds several HandlerExceptionResolver
# beans, startup fails with NoUniqueBeanDefinitionException - pointing at a
# constructor that contains no annotation to explain it.
#
# Listing the annotations here makes Lombok carry them through.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy

# @Data and @Value are banned on entities by the project conventions; flagging
# them here turns an accidental use into a build warning.
lombok.data.flagUsage = WARNING
lombok.value.flagUsage = WARNING

# Generated code is not ours to analyse or cover.
lombok.addLombokGeneratedAnnotation = true
